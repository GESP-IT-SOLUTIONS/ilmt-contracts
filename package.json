    "fund:vesting:testnet": "npx hardhat run scripts/check-and-fund-vesting.ts --network tbsc",
    "fund:vesting:mainnet": "npx hardhat run scripts/check-and-fund-vesting.ts --network bnb",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage"
